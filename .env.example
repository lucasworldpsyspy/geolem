# Copie para .env e ajuste se quiser.
POSTGRES_DB=geolem
POSTGRES_USER=geolem
POSTGRES_PASSWORD=troque-esta-senha
DB_PORTA=5432
API_PORTA=8000

# Região coberta pelas cargas (lon_min,lat_min,lon_max,lat_max). Padrão: LEM e entorno.
REGIAO_BBOX=-46.7,-12.9,-45.0,-11.3

# Sobreposições menores que isto (ha) são ignoradas, para evitar falsos positivos de borda.
AREA_MINIMA_HA=0.1

# Endereço público do sistema (vai no QR code do laudo). Em produção: https://seu-dominio
URL_PUBLICA=http://localhost:8000

# Imagens de satélite de antes e depois no laudo (Sentinel-2). 0 desliga.
IMAGENS_SATELITE=1
